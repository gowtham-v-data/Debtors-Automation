      "parameters": {
        "jsCode": "// Get text output from previous node (Analyze Document)\nconst text = $json.documentText || $json.text || \"\";\n\n// Chunk size settings\nconst chunkSize = 500;   // 500 characters per chunk (works best for Pinecone)\nconst overlap = 50;      // 50 character overlap prevents context loss\n\n// Prepare output array\nlet chunks = [];\n\nfor (let i = 0; i < text.length; i += (chunkSize - overlap)) {\n  const chunk = text.slice(i, i + chunkSize);\n\n  chunks.push({\n    json: {\n      id: `chunk_${i}`,   // unique ID for Pinecone vector\n      text: chunk\n    }\n  });\n}\n\nreturn chunks;\n"
      },
