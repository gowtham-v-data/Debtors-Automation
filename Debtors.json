    {
      "parameters": {
        "jsCode": "const data = items[0].json;\nconst transcript = data.transcript?.toLowerCase() || \"\";\n\nlet outcome = \"UNCLEAR\";\nlet next_call_at = \"\";\nlet notes = \"\";\n\n// Utility: Add minutes/days\nfunction addTime(type, amount) {\n  let d = new Date();\n  if (type === \"minutes\") d.setMinutes(d.getMinutes() + amount);\n  if (type === \"hours\") d.setHours(d.getHours() + amount);\n  if (type === \"days\") d.setDate(d.getDate() + amount);\n  return d.toISOString();\n}\n\n// ---- Pre-calculate callback timing matches ----\nconst matchDays = transcript.match(/(\\d+)\\s*day/);\nconst matchMinutes = transcript.match(/(\\d+)\\s*minute/);\nconst matchHours = transcript.match(/(\\d+)\\s*hour/);\n\n/* ------------------------------------------\n   0. WRONG NUMBER  (HIGH PRIORITY)\n---------------------------------------------*/\nif (\n  transcript.includes(\"wrong number\") ||\n  transcript.includes(\"not my number\") ||\n  transcript.includes(\"this is not\") ||\n  transcript.includes(\"no such person\") ||\n  transcript.includes(\"you called the wrong person\") ||\n  transcript.includes(\"don't know\") ||\n  transcript.includes(\"i dont know him\") ||\n  transcript.includes(\"i don't know her\") ||\n  transcript.includes(\"not the person\")\n) {\n  outcome = \"WRONG_NUMBER\";\n  notes = \"Wrong number — unrelated person.\";\n  next_call_at = addTime(\"days\", 1);\n}\n\n/* ------------------------------------------\n   1. PAYMENT CONFIRMED\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"i will pay\") ||\n  transcript.includes(\"pay today\") ||\n  transcript.includes(\"pay now\") ||\n  (transcript.includes(\"paid\") && !transcript.includes(\"already paid\"))\n) {\n  outcome = \"PAID\";\n  notes = \"Customer agreed to pay.\";\n}\n\n/* ------------------------------------------\n   2. CUSTOMER ALREADY PAID\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"already paid\") ||\n  transcript.includes(\"i paid already\") ||\n  transcript.includes(\"i have paid\")\n) {\n  outcome = \"ALREADY_PAID\";\n  notes = \"Customer claims they already paid.\";\n}\n\n/* ------------------------------------------\n   3. CALLBACK REQUEST / LATER\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"call me later\") ||\n  transcript.includes(\"call later\") ||\n  transcript.includes(\"call back\") ||\n  transcript.includes(\"remind me\") ||\n  transcript.includes(\"later\") ||\n  transcript.includes(\"busy\") ||\n  transcript.includes(\"not now\")\n) {\n  outcome = \"CALL_LATER\";\n  notes = \"Customer requested a callback.\";\n\n  if (matchDays) next_call_at = addTime(\"days\", parseInt(matchDays[1]));\n  else if (matchMinutes) next_call_at = addTime(\"minutes\", parseInt(matchMinutes[1]));\n  else if (matchHours) next_call_at = addTime(\"hours\", parseInt(matchHours[1]));\n  else next_call_at = addTime(\"hours\", 1);\n}\n\n/* ------------------------------------------\n   4. REFUND REQUEST\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"refund\") ||\n  transcript.includes(\"want refund\")\n) {\n  outcome = \"REFUND_REQUEST\";\n  notes = \"Customer requested a refund.\";\n}\n\n/* ------------------------------------------\n   5. NEED EXTENSION\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"two months\") ||\n  transcript.includes(\"1 month\") ||\n  transcript.includes(\"2 months\") ||\n  transcript.includes(\"give me time\") ||\n  transcript.includes(\"need extension\") ||\n  transcript.includes(\"give me more days\")\n) {\n  outcome = \"NEED_EXTENSION\";\n  notes = \"Customer requested additional time.\";\n  next_call_at = addTime(\"days\", 3);\n}\n\n/* ------------------------------------------\n   6. REFUSAL TO PAY\n---------------------------------------------*/\nelse if (\n  transcript.includes(\"not paying\") ||\n  transcript.includes(\"refuse\") ||\n  transcript.includes(\"stop calling\") ||\n  transcript.includes(\"no i won't pay\") ||\n  transcript.includes(\"dont call me\")\n) {\n  outcome = \"REFUSED\";\n  notes = \"Customer refused to pay.\";\n}\n\n/* ------------------------------------------\n   7. DEFAULT (UNCLEAR)\n---------------------------------------------*/\nif (outcome === \"UNCLEAR\") {\n  notes = \"No clear intent detected.\";\n}\n\n// -------- Return clean response to n8n --------\nreturn [\n  {\n    json: {\n      debtor_id: data.id,\n      name: data.customer?.name || \"\",\n      phone: data.customer?.number || \"\",\n      transcript: data.transcript || \"\",\n      summary: data.summary || \"\",\n      recordingUrl: data.recordingUrl || \"\",\n      startedAt: data.startedAt || \"\",\n      endedAt: data.endedAt || \"\",\n      last_call_result: outcome,\n      next_call_at: next_call_at,\n      notes: notes\n    }\n  }\n];\n"
      },
